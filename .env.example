# Copie este arquivo para ".env" (na raiz do projeto) e preencha com valores reais.
# O docker-compose lê ".env" automaticamente.
#
# POSTGRES_PASSWORD, SECRET_KEY e JWT_SECRET_KEY são obrigatórios.
# ALLOWED_ORIGINS tem um valor padrão de desenvolvimento.

POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
ALLOWED_ORIGINS=https://localhost,https://192.168.1.233
